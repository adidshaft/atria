+/// Recovery-HRV sub-window selection.
+///
+/// PROVENANCE: this adopts a PHYSIOLOGY choice popularized by WHOOP (US9750415B2)
+/// — measure recovery HRV from the LAST slow-wave-sleep (SWS / N3 "deep") window
+/// before waking, when the autonomic system is at its most quiescent and least
+/// contaminated by movement or arousals. That underlying claim (SWS-HRV as a
+/// recovery proxy) is generic prior art and is adopted here only as a choice of
+/// *which RR sub-window* to read. Atria keeps its OWN recovery model and weights;
+/// WHOOP's specific recovery weightings are trade-secret and are neither used nor
+/// reproduced. This selection changes the measured window only — the downstream
+/// recovery scoring is untouched.
+///
+/// FEASIBILITY / HONESTY: SWS labeling in Atria is MOTION-GATED. On heart-rate-only
+/// nights the stage engine cannot separate slow-wave sleep ("Stages need checked
+/// evidence") and produces no trustworthy deep segments. This selector therefore
+/// returns `nil` — signalling the caller to fall back to the existing whole-night /
+/// 04:00–11:00 recovery-eligibility rule — whenever staging is not motion-validated
+/// or no deep phase is available. It never fabricates a stage.
+enum AtriaRecoveryHRVWindowSelection {
+    /// A candidate HRV sub-window that has ALREADY passed the standard readiness
+    /// gates (>= 300 s coverage, RR gap <= 3 s, confidence >= 0.75). This selector
+    /// only chooses *among* gate-passing windows by sleep stage; it never relaxes a
+    /// gate.
+    struct Candidate: Equatable {
+        let start: Date
+        let end: Date
+        /// RMSSD (ms) for this window.
+        let rmssd: Double
+        /// Quality proxy used to rank equally-eligible windows (e.g. accepted beats).
+        let quality: Double
+
+        init(start: Date, end: Date, rmssd: Double, quality: Double) {
+            self.start = start
+            self.end = end
+            self.rmssd = rmssd
+            self.quality = quality
+        }
+
+        var midpoint: Date {
+            Date(timeIntervalSinceReferenceDate:
+                    (start.timeIntervalSinceReferenceDate + end.timeIntervalSinceReferenceDate) / 2)
+        }
+    }
+
+    /// Both `.sws` and `.deep` are N3/slow-wave sleep (Atria's algorithm emits two
+    /// HR-delta bands that fold to one physiological "deep" stage). Either qualifies.
+    static func isSlowWave(_ stage: SleepStageKind) -> Bool {
+        stage == .sws || stage == .deep
+    }
+
+    /// Returns the gate-passing candidate window that lies in the LAST slow-wave
+    /// (SWS/deep) phase before `wake`, preferring the highest-quality window when
+    /// several fall inside that phase (tie-break: the window closest to waking).
+    ///
+    /// Returns `nil` — meaning "no SWS-preferred window; caller must fall back to the
+    /// current recovery-eligibility rule" — when:
+    ///   * staging is not motion-validated (`stagingIsMotionValidated == false`),
+    ///   * there are no candidates,
+    ///   * there is no slow-wave/deep segment that starts before `wake`, or
+    ///   * no candidate temporally overlaps that last slow-wave phase.
+    static func lastSlowWaveWindow(candidates: [Candidate],
+                                   stageSegments: [SleepStageSegment],
+                                   wake: Date,
+                                   stagingIsMotionValidated: Bool) -> Candidate? {
+        guard stagingIsMotionValidated, !candidates.isEmpty else { return nil }
+        let slowWavePhases = stageSegments
+            .filter { isSlowWave($0.stage) && $0.end > $0.start && $0.start < wake }
+            .sorted { $0.end < $1.end }
+        guard let lastPhase = slowWavePhases.last else { return nil }
+
+        // A window counts if it overlaps the last slow-wave phase at all, so a
+        // five-minute window straddling the phase edge is not lost. When several
+        // overlap, windows whose midpoint sits inside the phase are preferred over
+        // ones that merely clip its edge.
+        let overlapping = candidates.filter { $0.end > lastPhase.start && $0.start < lastPhase.end }
+        guard !overlapping.isEmpty else { return nil }
+        let interior = overlapping.filter {
+            $0.midpoint >= lastPhase.start && $0.midpoint <= lastPhase.end
+        }
+        let pool = interior.isEmpty ? overlapping : interior
+        return pool.max { lhs, rhs in
+            if lhs.quality != rhs.quality { return lhs.quality < rhs.quality }
+            return lhs.end < rhs.end
+        }
+    }
+}
