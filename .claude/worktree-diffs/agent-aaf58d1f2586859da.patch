+    func testSleepDebtCapsAccumulatedDebt() {
+        // A catastrophic week (every night 10h short) recency-weights to ~34.7h;
+        // the explicit cap clamps accumulated debt to one night's need.
+        let catastrophic = Array(repeating: (needed: 10.0, slept: 0.0), count: 7)
+        XCTAssertEqual(AtriaSleepBudget.sleepDebt(nights: catastrophic),
+                       AtriaSleepBudget.maxSleepDebtHours,
+                       accuracy: 0.0001)
+
+        // Below the cap the raw recency-weighted sum is returned unchanged.
+        let mild = AtriaSleepBudget.sleepDebt(nights: [
+            (needed: 8, slept: 7),
+            (needed: 8, slept: 6),
+            (needed: 8, slept: 8)
+        ])
+        XCTAssertEqual(mild, 1 * 0.75 * 0.75 + 2 * 0.75, accuracy: 0.0001)
+        XCTAssertLessThan(mild, AtriaSleepBudget.maxSleepDebtHours)
+
+        // The debtAdder contribution to Need is bounded too: a debtHours far above
+        // the cap adds only maxSleepDebtHours * 0.5, not debtHours * 0.5.
+        let cappedComponents = AtriaSleepBudget.sleepNeedComponents(baseHours: 8,
+                                                                    yesterdayStrain: nil,
+                                                                    debtHours: 100,
+                                                                    sameDayNapHours: 0)
+        XCTAssertEqual(cappedComponents.debtAdderHours,
+                       AtriaSleepBudget.maxSleepDebtHours * 0.5,
+                       accuracy: 0.0001)
+
+        // A below-cap debtHours still contributes its uncapped 0.5x share.
+        let mildComponents = AtriaSleepBudget.sleepNeedComponents(baseHours: 8,
+                                                                  yesterdayStrain: nil,
+                                                                  debtHours: 2,
+                                                                  sameDayNapHours: 0)
+        XCTAssertEqual(mildComponents.debtAdderHours, 1.0, accuracy: 0.0001)
+    }
